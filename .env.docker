# =============================================================================
# Docker platform configuration
#
# Consumed by `docker compose --env-file .env.docker`. This file configures the
# INFRASTRUCTURE; the application's own .env is separate and unaffected.
#
# ⚠ The values below are development defaults and are safe to commit. For any
#   deployed environment, override them — and read the "Secrets" note at the
#   bottom before putting a real password anywhere near this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Project identity
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=laravel
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Image versions — bump these to upgrade the platform
# -----------------------------------------------------------------------------
PHP_VERSION=8.4
NODE_VERSION=22
COMPOSER_VERSION=2.8
NGINX_VERSION=1.29
MYSQL_VERSION=8.4
REDIS_VERSION=8

# -----------------------------------------------------------------------------
# Host integration
#
# UID/GID must match your host user or bind-mounted files come out root-owned.
# The Makefile detects them automatically; these are the fallbacks.
# -----------------------------------------------------------------------------
UID=1000
GID=1000
DOCKER_USER=app
TZ=UTC

# -----------------------------------------------------------------------------
# Published ports (host side)
#
# Only nginx is exposed publicly. MySQL and Redis bind to 127.0.0.1 only, and
# use non-default host ports so they do not collide with services already
# installed on the machine.
# -----------------------------------------------------------------------------
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6380

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Left EMPTY on purpose.
#
# In development the bind-mounted .env supplies APP_KEY, so nothing is needed
# here. In production there is no .env inside the image (.dockerignore keeps it
# out so it can never reach a registry), so the key must be supplied through
# the environment:
#
#     APP_KEY="$(make artisan ARGS='key:generate --show')" make prod-up
#
# or, properly, as a Docker secret. Never commit a real key to this file — it
# decrypts every encrypted column, cookie and session the application has.
APP_KEY=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_TEST_DATABASE=laravel_testing
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# -----------------------------------------------------------------------------
# Redis
#
# A password is set even in development, so the authenticated path is the one
# that actually gets exercised day to day. The Redis entrypoint REFUSES to
# start without a password when APP_ENV=production, so it cannot be forgotten
# on the way out — but leave it unset locally and you would never notice the
# app was misconfigured until deploy.
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=local_dev_redis_password
REDIS_CLIENT=phpredis
REDIS_MAXMEMORY=512mb

# -----------------------------------------------------------------------------
# Laravel drivers
# -----------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# -----------------------------------------------------------------------------
# Queue worker
# -----------------------------------------------------------------------------
QUEUE_WORKERS=2
QUEUE_NAME=default
QUEUE_TRIES=3
QUEUE_BACKOFF=5
QUEUE_TIMEOUT=60
QUEUE_SLEEP=3
QUEUE_MAX_TIME=3600
QUEUE_MAX_JOBS=1000
QUEUE_MEMORY=256

# -----------------------------------------------------------------------------
# Nginx
# -----------------------------------------------------------------------------
NGINX_SERVER_NAME=_
NGINX_FPM_HOST=app
NGINX_FPM_PORT=9000
NGINX_ROOT=/var/www/html/public

# -----------------------------------------------------------------------------
# Xdebug — off by default (it costs 2-5x on every request when active)
#   XDEBUG_MODE=debug make restart
# -----------------------------------------------------------------------------
XDEBUG_MODE=off
XDEBUG_SERVER_NAME=laravel

# -----------------------------------------------------------------------------
# Runtime behaviour
# -----------------------------------------------------------------------------
RESTART_POLICY=unless-stopped
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# -----------------------------------------------------------------------------
# Production resource limits (used only by docker-compose.prod.yml)
# -----------------------------------------------------------------------------
APP_CPU_LIMIT=2
APP_MEMORY_LIMIT=1g
APP_MEMORY_RESERVATION=256m
NGINX_CPU_LIMIT=1
NGINX_MEMORY_LIMIT=256m
QUEUE_CPU_LIMIT=2
QUEUE_MEMORY_LIMIT=1g
SCHEDULER_CPU_LIMIT=1
SCHEDULER_MEMORY_LIMIT=512m
DB_CPU_LIMIT=4
DB_MEMORY_LIMIT=4g
DB_MEMORY_RESERVATION=1g
REDIS_CPU_LIMIT=1
REDIS_MEMORY_LIMIT=1g

# =============================================================================
# Secrets
# =============================================================================
# Do NOT put production credentials in this file. Compose interpolation makes
# every value here visible in `docker inspect` and in the container's
# environment, which is exactly where a compromised dependency looks first.
#
# For production, use Docker secrets. Every component here already reads the
# *_FILE convention:
#
#   services:
#     mysql:
#       environment:
#         MYSQL_ROOT_PASSWORD_FILE: /run/secrets/db_root_password
#       secrets: [db_root_password]
#     redis:
#       environment:
#         REDIS_PASSWORD_FILE: /run/secrets/redis_password
#       secrets: [redis_password]
#
#   secrets:
#     db_root_password:
#       file: ./secrets/db_root_password.txt   # or external: true
#     redis_password:
#       file: ./secrets/redis_password.txt
#
# The MySQL and Redis healthchecks resolve *_FILE first, so they keep working.
