COMPOSE_PROJECT_NAME=metrial-realtime-cluster
APP_ENV=local
APP_DEBUG=false
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_URL=http://realtime-cluster.test
DB_DATABASE=metrial_cluster
DB_TEST_DATABASE=metrial_cluster_test
DB_USERNAME=metrial
DB_PASSWORD=metrial_cluster_database_password
DB_ROOT_PASSWORD=metrial_cluster_root_password
REDIS_PASSWORD=metrial_cluster_redis_password
REALTIME_ENABLED=true
REALTIME_ALLOWED_ORIGINS=http://realtime-cluster.test
REALTIME_INTERNAL_SECRET=cluster-internal-secret-for-automated-tests-only-000001
REALTIME_EVENT_HMAC_SECRET=cluster-event-hmac-secret-for-automated-tests-only-000001
REALTIME_REDIS_KEY_PREFIX=metrial:cluster:
REALTIME_EVENT_CHANNEL=metrial:cluster:events
REALTIME_LOG_LEVEL=info
RESTART_POLICY=no
