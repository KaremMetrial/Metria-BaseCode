NODE_ENV=development
REALTIME_HOST=0.0.0.0
REALTIME_PORT=6001
REALTIME_PATH=/socket.io
REALTIME_ALLOWED_ORIGINS=http://localhost
REALTIME_MAX_CONNECTIONS_PER_USER=10
REALTIME_MAX_ROOMS_PER_SOCKET=20
REALTIME_MAX_PAYLOAD_BYTES=65536
REALTIME_AUTH_URL=http://nginx:8080/api/internal/realtime/authenticate
REALTIME_RESOURCE_AUTH_URL=http://nginx:8080/api/internal/realtime/authorize-resource
REALTIME_INTERNAL_SECRET=
REALTIME_SESSION_TTL_SECONDS=300
REALTIME_REDIS_URL=redis://redis:6379
REALTIME_REDIS_PASSWORD=
REALTIME_REDIS_KEY_PREFIX=metrial:realtime:
REALTIME_EVENT_CHANNEL=metrial:realtime:events
REALTIME_EVENT_HMAC_SECRET=
REALTIME_LOG_LEVEL=info
REALTIME_SHUTDOWN_TIMEOUT_MS=10000
