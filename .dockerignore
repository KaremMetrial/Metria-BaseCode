# =============================================================================
# Build context exclusions
#
# Two jobs:
#   1. Keep the context small — everything here is uploaded to the daemon on
#      every build, and a stray node_modules turns a 3s context into 90s.
#   2. Keep secrets and host-built artefacts OUT of the image. `.env` in
#      particular must never be baked in: images get pushed to registries.
# =============================================================================

# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx
auth.json

# --- Dependencies (reinstalled inside the image) ------------------------------
vendor/
node_modules/
bower_components/

# --- Build output (regenerated by the assets stage) ---------------------------
public/build/
public/hot
public/storage
.vite/

# --- Laravel runtime state ----------------------------------------------------
storage/app/*
!storage/app/.gitignore
!storage/app/public/.gitignore
storage/framework/cache/*
!storage/framework/cache/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/testing/*
!storage/framework/testing/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/logs/*
!storage/logs/.gitignore
storage/debugbar/
bootstrap/cache/*
!bootstrap/cache/.gitignore

# --- Tooling caches -----------------------------------------------------------
.phpunit.result.cache
.phpunit.cache/
.pest/
.php-cs-fixer.cache
.phpstan.cache/
phpstan.cache/
coverage/
.nyc_output/

# --- VCS / CI -----------------------------------------------------------------
.git/
.gitignore
.gitattributes
.github/
.gitlab-ci.yml

# --- Editors / OS -------------------------------------------------------------
.idea/
.vscode/
.fleet/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Docker's own files -------------------------------------------------------
# Excluded from the *app* build context; the Dockerfiles are read by the
# builder directly, not copied into the image.
compose/
Makefile
README.md
docs/
backups/

# NOTE: docker/ is deliberately NOT excluded — the PHP and nginx Dockerfiles
# COPY their configuration out of it (docker/php/php.ini, docker/nginx/... ).
