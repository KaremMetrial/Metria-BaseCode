# =============================================================================
# npm defaults for the container toolchain
# =============================================================================

# Noise reduction — these write to stdout and pollute CI logs.
fund=false
audit=false
update-notifier=false

# Deterministic installs.
save-exact=false
package-lock=true

# Cache lives on the named node_cache volume (see compose), so it survives
# rebuilds and is shared between `npm install` and `npm ci`.
cache=/home/node/.npm

# Fail fast in CI rather than hanging on a slow mirror.
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# NOTE: do not add `omit=` here. An empty value is not valid for that key
# ("Must be one or more of: dev, optional, peer") and npm warns on every
# invocation. Vite and Rollup ship their native binaries as optional
# dependencies, which npm installs by default — nothing needs to be set.
