###############################################################################
# MySQL 8.4 LTS — server configuration
#
# Written against 8.4's variable set specifically. Several directives that are
# still widely copy-pasted from 5.7/8.0 guides were REMOVED in 8.4 and will
# cause mysqld to abort on startup:
#
#   default_authentication_plugin  → removed; use authentication_policy
#   skip-host-cache                → removed; use host_cache_size=0
#   expire_logs_days               → removed; use binlog_expire_logs_seconds
#   innodb_log_file_size           → superseded by innodb_redo_log_capacity
#   query_cache_*                  → removed back in 8.0
###############################################################################

[mysqld]

# --- Identity / networking ---------------------------------------------------
bind-address                    = 0.0.0.0
port                            = 3306
skip-name-resolve                          # never block a connection on DNS
host_cache_size                 = 0        # replaces the removed skip-host-cache

# --- Authentication ----------------------------------------------------------
# 8.4 disables mysql_native_password by default. Laravel's mysqlnd driver
# speaks caching_sha2_password natively, so there is no reason to re-enable it.
authentication_policy           = caching_sha2_password

# --- Character set -----------------------------------------------------------
# utf8mb4 is real 4-byte UTF-8 (emoji, astral planes). 0900_ai_ci is the 8.x
# Unicode 9.0 collation and is markedly faster than utf8mb4_unicode_ci.
character-set-server            = utf8mb4
collation-server                = utf8mb4_0900_ai_ci

# skip-character-set-client-handshake was REMOVED in MySQL 8.4 — leaving it in
# aborts startup with "unknown option". It is also unnecessary: Laravel's
# connection explicitly issues `SET NAMES utf8mb4` on connect, so the client
# charset is already what we want without overriding the handshake.

# --- SQL mode ----------------------------------------------------------------
# STRICT_ALL_TABLES turns silent truncation into an error. ONLY_FULL_GROUP_BY
# is Laravel-safe and catches genuinely ambiguous aggregate queries.
sql_mode = STRICT_ALL_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,NO_ZERO_DATE,NO_ZERO_IN_DATE,ONLY_FULL_GROUP_BY

# --- Time ---------------------------------------------------------------------
default_time_zone               = '+00:00'
explicit_defaults_for_timestamp = ON

# --- Storage engine -----------------------------------------------------------
default_storage_engine          = InnoDB
innodb_file_per_table           = ON

# Rule of thumb: 60-70% of the container's memory limit on a dedicated DB.
# 512M suits a development box; raise it with the compose memory limit.
innodb_buffer_pool_size         = 512M
innodb_buffer_pool_instances    = 1

# Redo capacity replaces innodb_log_file_size (8.0.30+). Too small and InnoDB
# stalls on furious checkpointing during bulk writes such as seeding.
innodb_redo_log_capacity        = 512M

# O_DIRECT skips the OS page cache, which would otherwise duplicate every page
# already held in the buffer pool.
innodb_flush_method             = O_DIRECT

# 1 = fully ACID; every commit is fsync'd. Do not lower this in production.
# Value 2 trades durability of the last ~1s of commits for throughput.
innodb_flush_log_at_trx_commit  = 1

innodb_log_buffer_size          = 32M
innodb_lock_wait_timeout        = 30
innodb_print_all_deadlocks      = ON
innodb_stats_on_metadata        = OFF

# Match the underlying storage. 200 suits SATA SSD; NVMe can take far more.
innodb_io_capacity              = 400
innodb_io_capacity_max          = 1200
innodb_flush_neighbors          = 0        # correct for any SSD

# --- Connections --------------------------------------------------------------
max_connections                 = 200
max_connect_errors              = 10000
max_allowed_packet              = 128M
wait_timeout                    = 600
interactive_timeout             = 600
thread_cache_size               = 32

# --- Table / temp sizing ------------------------------------------------------
table_open_cache                = 4000
table_definition_cache          = 2000
tmp_table_size                  = 64M
max_heap_table_size             = 64M
sort_buffer_size                = 4M
join_buffer_size                = 4M
read_rnd_buffer_size            = 2M

# --- Logging ------------------------------------------------------------------
# log_error is deliberately NOT set. When mysqld runs in the foreground (as it
# does here) an unset log_error means "write to stderr", which is exactly what
# the Docker logging driver collects.
#
# Do NOT set `log_error = /dev/stderr`: MySQL appends `.err` to any value
# without an extension, so it tries to open `/dev/stderr.err`, fails with
# "Permission denied", and then aborts with the very misleading message
# "The designated data directory /var/lib/mysql/ is unusable".
log_error_verbosity             = 2

# The slow log must go to a FILE: MySQL cannot stream it to stderr, and
# log_output=TABLE would write it into mysql.slow_log inside the datadir.
slow_query_log                  = ON
slow_query_log_file             = /var/log/mysql/slow.log
long_query_time                 = 1
log_queries_not_using_indexes   = ON
log_throttle_queries_not_using_indexes = 60
min_examined_row_limit          = 100

general_log                     = OFF      # never enable in production

# --- Binary log ---------------------------------------------------------------
# Kept on: it is what makes point-in-time recovery and replicas possible.
binlog_expire_logs_seconds      = 604800   # 7 days (replaces expire_logs_days)
max_binlog_size                 = 256M

# binlog_format is NOT set: it is deprecated as of 8.4 (ROW is the only
# supported value going forward and is already the default), and setting it
# logs a deprecation warning on every startup.

# --- Performance schema -------------------------------------------------------
performance_schema              = ON

[mysql]
default-character-set           = utf8mb4

[client]
default-character-set           = utf8mb4
